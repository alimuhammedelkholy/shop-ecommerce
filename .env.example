# Copy to .env (`cp .env.example .env` / `Copy-Item .env.example .env`) and change the secrets before exposing anything.

# SQL Server `sa` password (needs upper + lower + digit, 8+ chars)
MSSQL_SA_PASSWORD=Shop_Passw0rd_2026

# HMAC key used to sign login tokens. 32+ random characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-string-0123456789

# Seeded accounts (public demo values: change them for anything beyond your own machine)
SEED_ADMIN_EMAIL=admin@shop.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_DEMO_EMAIL=demo@shop.local
SEED_DEMO_PASSWORD=Demo@12345

# Published ports
WEB_PORT=8080
API_PORT=5080
